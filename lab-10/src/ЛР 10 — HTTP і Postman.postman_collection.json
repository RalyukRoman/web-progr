      "name": "01 — Список завдань",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));\r\npm.test(\"Відповідь JSON\", () => {\r\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r\n});\r\npm.test(\"Масив і правильний підсумок\", () => {\r\n    const body = pm.response.json();\r\n    pm.expect(body.data).to.be.an(\"array\");\r\n    pm.expect(body.meta.count).to.equal(body.data.length);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}?resource=tasks",
          "host": [
            "{{base_url}}"
          ],
          "query": [
            {
              "key": "resource",
              "value": "tasks"
            }
          ]
        }
      },
