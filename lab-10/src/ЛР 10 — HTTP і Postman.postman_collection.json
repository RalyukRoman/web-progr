    {
      "name": "04 — Створити завдання",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));\r\nif (pm.response.code === 201) {\r\n    const task = pm.response.json().data;\r\n    pm.test(\"Правильний запис\", () => {\r\n        pm.expect(task.id).to.be.a(\"number\").above(0);\r\n        pm.expect(task.title).to.equal(\"Перевірити POST\");\r\n        pm.expect(task.done).to.equal(false);\r\n    });\r\n    if (Number.isInteger(task.id)) {\r\n        pm.environment.set(\"task_id\", task.id);\r\n    }\r\n}"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.unset(\"task_id\");"
            ]
          }
        }
      ],
