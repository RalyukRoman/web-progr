  "item": [
    {
      "name": "Пошук за підрядком",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\npm.test(\"Знайдено записи незалежно від регістру\", () => {\r\n    const json = pm.response.json();\r\n    pm.expect(json.data.length).to.be.above(0);\r\n    pm.expect(json.data[0].title.toLowerCase()).to.include(\"тест\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}?resource=tasks&q=ТЕСТ",
          "host": [
            "{{base_url}}"
          ],
          "query": [
            {
              "key": "resource",
              "value": "tasks"
            },
            {
              "key": "q",
              "value": "ТЕСТ"
            }
          ]
        }
      },
      "response": []
    },
