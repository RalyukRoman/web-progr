            "exec": [
              "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\npm.test(\"Порожній список у результаті\", () => {\r\n    const json = pm.response.json();\r\n    pm.expect(json.data).to.be.an('array').that.is.empty;\r\n    pm.expect(json.meta.count).to.equal(0);\r\n});"
            ]
          }
        }
      ],
