    {
      "name": "Поєднання q та done",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200 OK\", () => pm.response.to.have.status(200));\r\npm.test(\"Запис відповідає двом фільтрам\", () => {\r\n    const json = pm.response.json();\r\n    json.data.forEach(task => {\r\n        pm.expect(task.done).to.be.true;\r\n        pm.expect(task.title.toLowerCase()).to.include(\"підготувати\");\r\n    });\r\n});"
            ]
          }
        }
      ],
